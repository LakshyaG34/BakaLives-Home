API_PORT=4000
# Use this for Supabase. Keep the URI private and do not commit backend/.env.
SUPABASE_CONNECTION_URI=
# Local PostgreSQL fallback when SUPABASE_CONNECTION_URI is not set.
DATABASE_URL=postgresql://bakalives:bakalives@localhost:5432/bakalives
# Optional SSL for other hosted PostgreSQL providers. Supabase URI enables SSL automatically.
DB_SSL=false
# Comma-separated frontend origins. Leave empty to allow any origin in development.
CLIENT_ORIGINS=http://localhost:5173
